<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipToPadding="false"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:indeterminate="true"
            android:paddingHorizontal="20dp"
            android:visibility="invisible"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp"
            app:waveAmplitude="4dp"
            app:wavelength="36dp" />

        <LinearLayout
            android:id="@+id/results_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/short_list_gag"
                android:layout_width="match_parent"
                android:layout_height="0px"
                android:layout_weight="1"
                android:fontFamily="@font/google_sans_flex_regular"
                android:gravity="center"
                android:padding="24dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="0px"
                    android:layout_gravity="bottom"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ListView
                        android:id="@+id/results_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:divider="@null"
                        android:dividerHeight="-8dp"
                        android:fadeScrollbars="false"
                        android:fadingEdgeLength="48dp"
                        android:overScrollMode="never"
                        android:requiresFadingEdge="vertical"
                        android:scrollbars="none"
                        android:stackFromBottom="true" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/nominatim_attribution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans_flex_regular"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:text="@string/nominatim_attribution"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:translationY="4dp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:fontFamily="@font/google_sans_flex_regular"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/no_results"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_location" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_flex_regular"
                android:text="@string/search_for_a_location"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </FrameLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/provider_toggle_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="46dp"
        android:layout_marginBottom="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.razvanalbu.material.not.you.widgets.views.StatefulFontButton
            android:id="@+id/provider_metno"
            style="@style/Widget.Material3Expressive.Button.TonalButton"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/provider_metno" />

        <com.razvanalbu.material.not.you.widgets.views.StatefulFontButton
            android:id="@+id/provider_openmeteo"
            style="@style/Widget.Material3Expressive.Button.TonalButton"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/provider_openmeteo" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_bar_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="16dp"
                android:fadingEdge="horizontal"
                android:fontFamily="@font/google_sans_flex_regular"
                android:hint="@string/location"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:paddingStart="20dp"
                android:paddingEnd="10dp"
                android:requiresFadingEdge="horizontal"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <ImageView
                android:id="@+id/clear_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear_search"
                android:padding="6dp"
                android:src="@drawable/ic_delete"
                android:visibility="gone" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>